n111" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6c8ebf;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="n92" target="n100"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n112" value="PR #66 · revisión cruzada" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;" edge="1" parent="1" source="n102" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n113" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#d6b656;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="n93" target="n103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n114" value="PR #67" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d6b656;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;" edge="1" parent="1" source="n104" target="n94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n115" value="módulo ECS" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="230" width="60" height="20" as="geometry"/></mxCell><mxCell id="n116" value="fix tflint" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="230" width="60" height="20" as="geometry"/></mxCell><mxCell id="n117" value="datos" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="505" y="340" width="60" height="20" as="geometry"/></mxCell><mxCell id="n118" value="test/prod" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="585" y="340" width="60" height="20" as="geometry"/></mxCell><mxCell id="n119" value="deploy" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="665" y="340" width="60" height="20" as="geometry"/></mxCell><mxCell id="n120" value="ADRs" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="825" y="450" width="60" height="20" as="geometry"/></mxCell><mxCell id="n121" value="cada push a main → CI → Deploy" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="200" height="30" as="geometry"/></mxCell><mxCell id="n122" value="&lt;b&gt;Reglas de main&lt;/b&gt;&lt;br&gt;• PR obligatorio, sin commits directos&lt;br&gt;• Al menos 1 aprobación del otro integrante&lt;br&gt;• Aprobaciones viejas se descartan al subir cambios&lt;br&gt;• Conversaciones resueltas&lt;br&gt;• Checks de CI en verde&lt;br&gt;• Sin bypass para nadie (ni administradores)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ramas de trabajo&lt;/b&gt;&lt;br&gt;• Cortas, una por cambio: feat/, fix/, docs/, ci/&lt;br&gt;• Nacen de main y vuelven a main por PR&lt;br&gt;• Sin develop ni release (equipo de 2, despliegue continuo)&lt;br&gt;&lt;br&gt;&lt;b&gt;Después del merge&lt;/b&gt;&lt;br&gt;• El push a main dispara CI; si pasa, Deploy a Dev → Test → Prod&lt;br&gt;• Rollback: Deploy manual con un SHA anterior" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f9f9f9;strokeColor=#999999;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="700" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>